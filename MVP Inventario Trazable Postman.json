{
  "info": {
    "name": "MVP Inventario Trazable",
    "description": "Coleccion Postman para la API MVP Inventario Trazable. Importe este JSON y configure baseUrl e IDs segun la base de datos. El login guarda accessToken y refreshToken automaticamente. Cuenta demo: sigati.admin@example.com / SigatiDemo123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "id_usuario", "value": "1", "type": "string" },
    { "key": "id_rol", "value": "1", "type": "string" },
    { "key": "id_activo", "value": "1", "type": "string" },
    { "key": "id_evento", "value": "1", "type": "string" },
    { "key": "id_sucursal", "value": "1", "type": "string" },
    { "key": "id_departamento", "value": "1", "type": "string" },
    { "key": "id_marca", "value": "1", "type": "string" },
    { "key": "id_modelo", "value": "1", "type": "string" },
    { "key": "id_tipo", "value": "1", "type": "string" },
    { "key": "id_estado", "value": "1", "type": "string" },
    { "key": "limit", "value": "50", "type": "string" },
    { "key": "offset", "value": "0", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.access_token);",
                  "pm.collectionVariables.set('refreshToken', data.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"sigati.admin@example.com\",\n  \"password\": \"SigatiDemo123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/authentication/login"
          }
        },
        {
          "name": "POST Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh exitoso', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.access_token);",
                  "pm.collectionVariables.set('refreshToken', data.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/authentication/refresh"
          }
        },
        {
          "name": "POST Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.unset('accessToken');",
                  "  pm.collectionVariables.unset('refreshToken');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/authentication/logout"
          }
        },
        {
          "name": "GET Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/authentication/me"
          }
        }
      ]
    },
    {
