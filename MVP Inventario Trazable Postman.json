          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"correo\": \"usuario.postman@example.com\",\n  \"password\": \"UsuarioDemo123!\",\n  \"id_rol\": {{id_rol}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "GET Obtener usuario",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/usuarios/{{id_usuario}}" }
        },
        {
          "name": "PUT Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario actualizado\",\n  \"correo\": \"usuario.postman@example.com\",\n  \"id_rol\": {{id_rol}},\n  \"activo\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/usuarios/{{id_usuario}}"
          }
        },
        {
          "name": "DELETE Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Eliminación permanente. Responde 409 si el usuario es la cuenta actual, tiene eventos de auditoría o conserva activos asignados; en esos casos, usa PATCH /desactivar.",
            "url": "{{baseUrl}}/usuarios/{{id_usuario}}"
          }
        },
        {
          "name": "PATCH Activar usuario",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/usuarios/{{id_usuario}}/activar" }
        },
        {
          "name": "PATCH Desactivar usuario",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/usuarios/{{id_usuario}}/desactivar" }
        }
      ]
